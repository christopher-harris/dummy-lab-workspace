# JetBrains IDE config. Tracked since the initial commit; untracked 2026-10-01.
# Kept local so per-developer IDE state (and the nx-angular-config.xml that
# regenerates on every project add) stops churning the history.
/.idea/

.env
.env.*
*.log

# Strapi spike residue. These are ignored by apps/cms/.gitignore, which is a
# tracked file living only on the strapi-spike branch -- so on every other
# branch they resurface as untracked and get swept up by `git add -A`.
# Repeated here because the root .gitignore is the only one present on every
# branch. Nothing is deleted; this only changes what git reports.
apps/cms/.strapi/
apps/cms/.strapi-updater.json
apps/cms/public/uploads/*
!apps/cms/public/uploads/.gitkeep

# Wrangler Pages local state and bindings. The committed example is safe/public.
apps/dummy-lab/.dev.vars
apps/dummy-lab/.dev.vars.*
!apps/dummy-lab/.dev.vars.example
apps/dummy-lab/.wrangler/

vitest.config.*.timestamp*

# Local performance/analytics output — Lighthouse reports, traces, LHCI runs.
# Never committed: these are machine- and network-specific measurements, and the
# HTML reports are large. Baselines worth keeping go in the docs as numbers.
/analytics/
