# Copy to .env.production on the host and fill in. Never reuse the values from
# .env: that file is committed to a public repo.
#
# Each secret: openssl rand -base64 32
# APP_KEYS takes four, comma-separated.

# Public hostname Caddy serves and gets a certificate for, without scheme.
CMS_DOMAIN=

# Set by every deploy (deploy/remote-deploy.sh) — don't edit by hand.
# CMS_IMAGE=<account>.dkr.ecr.us-east-1.amazonaws.com/dummy-lab-cms:<sha>

# Secrets
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# Database (host and port are set in compose.prod.yaml)
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=

# Preview. CLIENT_URL is set by every deploy from the CMS_PREVIEW_URL repo
# variable — change it there, not here.
# CLIENT_URL=https://dummy-lab-dev.pages.dev
PREVIEW_ENABLED=true
