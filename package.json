{
  "name": "dummy-lab-workspace",
  "version": "0.0.0",
  "private": true,
  "config": {
    "perfUrl": "https://dummy-lab-dev.pages.dev/"
  },
  "scripts": {
    "nx": "nx",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "check": "nx run-many -t lint build test",
    "check:affected": "nx affected -t lint build test",
    "perf": "npm run perf:desktop && npm run perf:mobile",
    "perf:desktop": "URL=\"${PERF_URL:-$npm_package_config_perfUrl}\"; lighthouse \"$URL\" --preset=desktop --output=html --output=json --chrome-flags=\"--headless=new\" --output-path=./analytics/lighthouse/$(echo \"$URL\" | sed -E 's#^https?://##; s#/+$##; s#[^A-Za-z0-9._-]+#-#g')-desktop-$(date +%Y%m%dT%H%M%S)",
    "perf:mobile": "URL=\"${PERF_URL:-$npm_package_config_perfUrl}\"; lighthouse \"$URL\" --output=html --output=json --chrome-flags=\"--headless=new\" --output-path=./analytics/lighthouse/$(echo \"$URL\" | sed -E 's#^https?://##; s#/+$##; s#[^A-Za-z0-9._-]+#-#g')-mobile-$(date +%Y%m%dT%H%M%S)"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.4",
    "@analogjs/vitest-angular": "2.6.4",
    "@angular-devkit/core": "22.1.9",
    "@angular-devkit/schematics": "22.1.9",
    "@angular/build": "22.1.9",
    "@angular/cli": "22.1.9",
    "@angular/compiler-cli": "22.1.8",
    "@angular/language-service": "22.1.8",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/web": "23.2.1",
    "@oxc-project/runtime": "^0.115.0",
    "@schematics/angular": "22.1.9",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "angular-eslint": "22.5.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^27.1.0",
    "lighthouse": "^13.5.0",
    "nx": "23.2.1",
    "postcss": "^8.5.15",
    "prettier": "~3.6.2",
    "tailwindcss": "^4.3.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.8",
    "wrangler": "^4.141.0"
  },
  "dependencies": {
    "@angular/common": "22.1.8",
    "@angular/compiler": "22.1.8",
    "@angular/core": "22.1.8",
    "@angular/forms": "22.1.8",
    "@angular/platform-browser": "22.1.8",
    "@angular/router": "22.1.8",
    "@ng-icons/core": "^34.0.0",
    "@ng-icons/heroicons": "^34.0.0",
    "@ng-icons/material-icons": "^34.0.0",
    "@ngrx-toolkit/core": "^22.0.1",
    "@ngrx/signals": "^22.0.0",
    "@ngrx/store": "^22.0.1",
    "@primeicons/angular": "^8.0.2",
    "@primeuix/themes": "^3.0.1",
    "primeicons": "^8.0.1",
    "primeng": "22.1.1",
    "rxjs": "~7.8.0",
    "tailwindcss-primeui": "^0.6.1"
  },
  "allowScripts": {
    "less@4.5.1": true,
    "less@4.6.6": true,
    "esbuild@0.27.3": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.1": true,
    "nx@23.0.0": true,
    "@parcel/watcher@2.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
